import string
file = open("sample_text.txt","r")
text = file.read().lower()
file.close()
for ch in string.punctuation:
    text = text.replace(ch,"")
words = text.split()
frequency = {}
for word in words:
    if word in frequency:
        frequency[word] += 1
    else:
        frequency[word] = 1
print("Word Frequency Distribution")
for word,count in frequency.items():
    print(word,"=",count)
